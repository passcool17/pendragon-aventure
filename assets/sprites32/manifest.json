  "tile_autotile_logic": {
    "herbe": "Variants herbe-1/2/3 are interchangeable fill tiles; mix for less repetition.",
    "chemin": {
      "fill": "chemin-terre.png",
      "edges": "chemin-bord-{n,s,e,o}.png — side facing the letter is path, opposite blends to grass.",
      "corners_ext": "chemin-coin-ext-{ne,no,se,so}.png — path fills the named outer corner.",
      "corners_int": "chemin-coin-int-{ne,no,se,so}.png — grass pocket in the named corner, path elsewhere.",
      "neighbor_rule": "Place edge/corner so the path side abuts chemin-terre or another path edge; grass side abuts herbe-*."
    },
    "eau": {
      "fill": "eau-ruisseau.png",
      "edges": "eau-berge-{n,s,e,o}.png — water on the named side, grass on the opposite (with pebble hints on berges).",
      "corners_ext": "eau-coin-ext-{ne,no,se,so}.png",
      "corners_int": "eau-coin-int-{ne,no,se,so}.png",
      "neighbor_rule": "Same adjacency logic as chemin, but primary material is water."
    }
  },
